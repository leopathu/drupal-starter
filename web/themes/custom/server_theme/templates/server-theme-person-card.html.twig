{#
/**
 * @file
 * Person Card component.
 *
 * Variables:
 * - image_url: URL of the person's image
 * - name: Person's name
 * - role: Person's role or title
 * - description: Brief description or bio
 */
#}

<div class="bg-white rounded-lg shadow-md overflow-hidden">
  {% if image_url %}
    <div class="aspect-w-4 aspect-h-3">
      <img src="{{ image_url }}" alt="{{ name }}" class="w-full h-full object-cover">
    </div>
  {% endif %}
  
  <div class="p-6">
    <h3 class="text-xl font-bold text-gray-900 mb-2">{{ name }}</h3>
    {% if role %}
      <p class="text-indigo-600 font-medium mb-4">{{ role }}</p>
    {% endif %}
    {% if description %}
      <p class="text-gray-600 text-sm">{{ description }}</p>
    {% endif %}
  </div>
</div>
