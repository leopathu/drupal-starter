{#
/**
 * @file
 * Person Card component.
 *
 * Variables:
 * - image_url: URL of the person's image
 * - name: Person's name
 * - role: Person's role or title
 * - description: Brief description or bio
 */
#}

{#
/**
 * @file
 * Person Card component.
 *
 * Variables:
 * - image_url: URL of the person's image
 * - name: Person's name
 * - role: Person's role or title
 * - is_admin: Boolean indicating if person is an admin
 */
#}

<div class="bg-white rounded-lg shadow-md flex flex-col items-center text-center border border-gray-200 shadow-lg">
    <div class="meta-wrapper p-6 w-full">
        {% if image_url %}
            <div class="mb-4 flex justify-center">
            <img src="{{ image_url }}" alt="{{ name }}" class="w-24 h-24 rounded-full object-cover">
            </div>
        {% endif %}
        
        <p class="text-lg font-semibold text-gray-900">{{ name }}</p>
        
        {% if description %}
            <p class="text-sm text-gray-600 mt-2 mb-2">{{ description }}</p>
        {% endif %}

        {% if role %}
            <span class="inline-block mt-2 px-4 py-2 text-xs font-medium text-green-800 bg-green-400 rounded-full">{{ role }}</span>
        {% endif %}
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2 w-full">
        <a class="flex items-center justify-center col-span-1 px-4 py-2 text-sm text-gray-700 bg-gray-100 hover:bg-gray-200 transition-colors border border-gray-200 p-4" style="padding:18px;" href="mailto:{{ mail }}">
        <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
        </svg>
        <span class="ml-4">Email</span>
        </a>
        <a class="flex items-center justify-center col-span-1 px-4 py-2 text-sm text-gray-700 bg-gray-100 hover:bg-gray-200 transition-colors border border-gray-200 p-4" style="padding:18px;" href="tel:{{ phone }}">
        <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span class="ml-4">Call</span>
        </a>
    </div>
</div>
